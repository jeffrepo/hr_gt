<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="view_hr_gt_recibo_pago_form" model="ir.ui.view">
            <field name="name">hr_gt.recibo_pago.form</field>
            <field name="model">hr_gt.recibo_pago</field>
            <field name="arch" type="xml">
                <form string="Planilla">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                        <notebook>
                            <page string="Reglas">
                                <field name="ingreso_ids"/>
                                <field name="deduccion_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="view_hr_gt_formato_planilla_form" model="ir.ui.view">
            <field name="name">hr_gt.formato_planilla.form</field>
            <field name="model">hr_gt.formato_planilla</field>
            <field name="arch" type="xml">
                <form string="Planilla">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="salario"/>
                        </group>
                        <notebook>
                            <page string="Reglas">
                                 <field name="regla_ids"/>
                            </page>    
                            <page string="Ingresos">
                                <label for="ingreso_ids" string="Ingresos"/>
                                <field name="ingreso_ids">
                                    <tree string="Ingresos" editable="bottom">
                                        <field name="name"/>
                                        <field name="regla_ids" widget="many2many_tags"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Egresos">
                                <label for="egreso_ids" string="Deducciones"/>
                                <field name="egreso_ids">
                                    <tree string="Egresos" editable="bottom">
                                        <field name="name"/>
                                        <field name="regla_ids" widget="many2many_tags"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_hr_gt_recibo_pago_tree" model="ir.ui.view">
            <field name="name">hr_gt.recibo_pago.tree</field>
            <field name="model">hr_gt.recibo_pago</field>
            <field name="arch" type="xml">
                <tree string="Formato">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        

        <record id="view_hr_gt_formato_planilla_tree" model="ir.ui.view">
            <field name="name">hr_gt.formato_planilla.tree</field>
            <field name="model">hr_gt.formato_planilla</field>
            <field name="arch" type="xml">
                <tree string="Formato">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record id="action_hr_gt_recibo_pago" model="ir.actions.act_window">
            <field name="name">Recibo de pago</field>
            <field name="res_model">hr_gt.recibo_pago</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
              </p>
            </field>
        </record>
        

        <record id="action_hr_gt_formato_planilla" model="ir.actions.act_window">
            <field name="name">Formato de planilla</field>
            <field name="res_model">hr_gt.formato_planilla</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
              <p class="oe_view_nocontent_create">
              </p>
            </field>
        </record>

        <menuitem
            id="hr_gt_menu_planilla_recibo"
            name="Recibo de pago"
            action="action_hr_gt_recibo_pago"
            parent="hr_work_entry_contract_enterprise.menu_hr_work_entry_configuration"
            sequence="110"/>
        

        <menuitem
            id="hr_gt_menu_planilla"
            name="Formato de planilla"
            action="action_hr_gt_formato_planilla"
            parent="hr_work_entry_contract_enterprise.menu_hr_work_entry_configuration"
            sequence="100"/>


    </data>
</odoo>
